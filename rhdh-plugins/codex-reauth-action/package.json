{
  "name": "agent-office-backstage-plugin-codex-reauth-action",
  "version": "0.0.1",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "description": "Backstage scaffolder backend module exposing the codex:reauth action. Runs OAuth device-code flow against OpenAI Codex and writes the resulting auth.json to Vault using CAS so concurrent refreshes don't collide.",
  "private": true,
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "scaffolder",
    "pluginPackage": "agent-office-backstage-plugin-codex-reauth-action"
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "tsc": "tsc",
    "export-dynamic": "janus-cli package export-dynamic-plugin --in-place --no-embed-as-dependencies"
  },
  "dependencies": {},
  "peerDependencies": {
    "@backstage/backend-plugin-api": "^1.0.0",
    "@backstage/plugin-scaffolder-node": "^0.5.0"
  },
  "devDependencies": {
    "@backstage/backend-plugin-api": "^1.0.0",
    "@backstage/cli": "^0.29.0",
    "@backstage/plugin-scaffolder-node": "^0.5.0",
    "@janus-idp/cli": "^1.18.0",
    "@types/node": "^20.0.0",
    "typescript": "~5.4.0"
  },
  "files": [
    "dist",
    "dist-dynamic/*.*",
    "dist-dynamic/dist/**",
    "dist-dynamic/alpha/*",
    "app-config.yaml"
  ]
}
