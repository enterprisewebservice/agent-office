{
  "name": "agent-office-backstage-plugin-agentworkstation-binders",
  "version": "0.0.6",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "description": "AgentWorkstation entity-page tab that lets users drag-and-drop bindings (KnowledgeBases, MemoryModules, SkillBindings) onto an agent. Each tab is an instance of a shared BindingPanel component. On Save, the plugin composes a YAML patch and fires the stock publish:github:pull-request scaffolder action against the cluster's gitops repo so changes flow through ArgoCD with full audit trail.",
  "private": true,
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "agentworkstation-binders",
    "pluginPackage": "agent-office-backstage-plugin-agentworkstation-binders"
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "tsc": "tsc",
    "export-dynamic": "janus-cli package export-dynamic-plugin --in-place --no-embed-as-dependencies"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "react-use": "^17.5.1"
  },
  "devDependencies": {
    "@backstage/catalog-model": "^1.7.0",
    "@backstage/cli": "^0.29.0",
    "@backstage/core-components": "^0.15.0",
    "@backstage/core-plugin-api": "^1.10.0",
    "@backstage/plugin-catalog-react": "^1.14.0",
    "@backstage/plugin-kubernetes": "^0.12.0",
    "@backstage/plugin-scaffolder": "^1.27.0",
    "@backstage/plugin-scaffolder-react": "^1.13.0",
    "@janus-idp/cli": "^1.18.0",
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "@material-ui/lab": "^4.0.0-alpha.61",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router": "^6.0.0",
    "react-router-dom": "^6.0.0",
    "typescript": "~5.4.0"
  },
  "peerDependencies": {
    "@backstage/catalog-model": "^1.7.0",
    "@backstage/core-components": "^0.15.0",
    "@backstage/core-plugin-api": "^1.10.0",
    "@backstage/plugin-catalog-react": "^1.14.0",
    "@backstage/plugin-kubernetes": "^0.12.0",
    "@backstage/plugin-scaffolder": "^1.27.0",
    "@backstage/plugin-scaffolder-react": "^1.13.0",
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "@material-ui/lab": "^4.0.0-alpha.61",
    "react": "^17 || ^18",
    "react-dom": "^17 || ^18"
  },
  "files": [
    "dist",
    "dist-scalprum",
    "app-config.yaml"
  ]
}
