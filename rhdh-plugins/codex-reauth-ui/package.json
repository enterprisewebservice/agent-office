{
  "name": "agent-office-backstage-plugin-codex-reauth-ui",
  "version": "0.0.6",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "description": "Frontend bits for the codex re-authentication flow: an entity-page card (Codex Subscription Auth) and a scaffolder field extension (CodexAuthPreflight) that gate template submission on Codex token freshness. Both open a shared in-browser OAuth dialog that runs the device-code flow against ChatGPT and posts the obtained tokens to the codex:reauth backend action for Vault storage.",
  "private": true,
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "codex-reauth-ui",
    "pluginPackage": "agent-office-backstage-plugin-codex-reauth-ui"
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "tsc": "tsc",
    "export-dynamic": "janus-cli package export-dynamic-plugin --in-place --no-embed-as-dependencies"
  },
  "dependencies": {
    "react-use": "^17.5.1"
  },
  "peerDependencies": {
    "@backstage/catalog-model": "^1.7.0",
    "@backstage/core-components": "^0.15.0",
    "@backstage/core-plugin-api": "^1.10.0",
    "@backstage/plugin-catalog-react": "^1.14.0",
    "@backstage/plugin-scaffolder": "^1.27.0",
    "@backstage/plugin-scaffolder-react": "^1.13.0",
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "@material-ui/lab": "^4.0.0-alpha.61",
    "react": "16.13.1 || ^17.0.0 || ^18.0.0",
    "react-dom": "16.13.1 || ^17.0.0 || ^18.0.0"
  },
  "devDependencies": {
    "@backstage/catalog-model": "^1.7.0",
    "@backstage/cli": "^0.29.0",
    "@backstage/core-components": "^0.15.0",
    "@backstage/core-plugin-api": "^1.10.0",
    "@backstage/plugin-catalog-react": "^1.14.0",
    "@backstage/plugin-scaffolder": "^1.27.0",
    "@backstage/plugin-scaffolder-react": "^1.13.0",
    "@janus-idp/cli": "^1.18.0",
    "@material-ui/core": "^4.12.4",
