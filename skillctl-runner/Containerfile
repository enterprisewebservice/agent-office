# skillctl-runner — skillctl on a shell+git base.
#
# Why this image exists: the upstream ghcr.io/redhat-et/skillctl image
# is distroless — no shell, no git. That makes it unusable for the
# in-cluster skill-importer pipeline, which needs to (a) git-clone an
# upstream skills repo, (b) loop over the skill folders, and (c) run
# `skillctl build` + `skillctl push` per skill. All of that needs a
# shell + git alongside the skillctl binary.
#
# This multi-stage build copies the skillctl binary (verified at
# /usr/local/bin/skillctl, v0.7.2) out of the trusted upstream image
# onto a ubi9-minimal base that has sh and (after microdnf) git.
#
# Built in-cluster by Konflux via .tekton/skillctl-runner-on-push.yaml
# (no laptop podman — cluster guardrail). Consumed by the importer
# pipeline at cluster/skill-importer/.
FROM ghcr.io/redhat-et/skillctl:latest AS skillctl

FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

# git: skillctl build of a local clone still shells out to git for
#      repo metadata; the pipeline also git-clones with it.
# tar/gzip: skillctl's OCI layer handling.
# ca-certificates: TLS to ghcr/quay.
RUN microdnf install -y git tar gzip ca-certificates && microdnf clean all

COPY --from=skillctl /usr/local/bin/skillctl /usr/local/bin/skillctl

# Fail the build loudly if the binary didn't come across or won't run
# on this base (e.g. glibc mismatch) — cheaper to catch here than in
# the importer pipeline.
RUN /usr/local/bin/skillctl --version

# Shell entrypoint so Tekton `script:` steps work.
ENTRYPOINT ["/bin/sh"]
